+  margin: .6em 0 .4em;
+}
+html[data-slp~="C02"] .md-typeset p {
+  margin: .5em 0;
+}
+
+/* C05 対応の段落を札の帯にする（prepare_site.py の p.slp-support。C06 と両立しない。C06 の span.slp-bw は C06 が無ければ普通の字） */
+html[data-slp~="C05"] .md-typeset p.slp-support {
+  padding: .25em .6em;
