diff --git a/scripts/prepare_site.py b/scripts/prepare_site.py
index 5f51016..d363b4d 100644
--- a/scripts/prepare_site.py
+++ b/scripts/prepare_site.py
@@ -223,6 +223,44 @@ def rewrite_links(text, src, dst):
     return '\n'.join(out)
 
 
+# ---------------------------------------------------------------- site-look-plan の使い捨ての試作（C04・C05・C06・C07・C11 の目印）
+
+SLP_SUPPORT = re.compile(r'^\*\*対応:\*\* ?(.*)$')
+SLP_BW = re.compile(r'^(Materia|SSP|CROW|Ninix)( \d\S*)?$')
+SLP_DEFAULT = re.compile(r'^\*\*既定値:\*\*')
+
+
+def slp_bw(part):
+    m = SLP_BW.match(part)
+    return f'<span class="slp-bw slp-bw-{m.group(1).lower()}">{m.group(1)}</span>{m.group(2) or ""}' if m else part
+
+
+def slp_mark(rel, text):
+    """**対応:**・**既定値:** の段落の末尾に {: .slp-support }・{: .slp-default } を足し、対応の名前を span.slp-bw で包む。notes_*.md の単位は div.slp-notes で包む"""
+    lines = text.split('\n')
+    in_fence = False
+    mark = None
+    for i, line in enumerate(lines):
+        if FENCE.match(line):
+            in_fence = not in_fence
+            continue
+        if in_fence:
+            continue
+        m = SLP_SUPPORT.match(line)
+        if m:
+            lines[i] = '**対応:** ' + ' / '.join(slp_bw(p) for p in m.group(1).split(' / '))
+            mark = 'slp-support'
+        elif SLP_DEFAULT.match(line):
