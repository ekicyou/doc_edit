+html[data-slp~="C06"] .md-typeset .slp-bw-ssp { color: #2e7d32; }
+html[data-slp~="C06"] .md-typeset .slp-bw-crow { color: #6a1b9a; }
+html[data-slp~="C06"] .md-typeset .slp-bw-ninix { color: #1565c0; }
+html[data-slp~="C06"] [data-md-color-scheme="slate"] .md-typeset .slp-bw-materia { color: #ffc260; }
+html[data-slp~="C06"] [data-md-color-scheme="slate"] .md-typeset .slp-bw-ssp { color: #81c784; }
+html[data-slp~="C06"] [data-md-color-scheme="slate"] .md-typeset .slp-bw-crow { color: #ce93d8; }
+html[data-slp~="C06"] [data-md-color-scheme="slate"] .md-typeset .slp-bw-ninix { color: #90caf9; }
+
+/* C08 記述例をひとかたまりの箱に見せる（h4 を箱の頭の帯にし、続くコードブロックをつなぐ。div.highlight・pre.highlight のどちらの形にも効く） */
+html[data-slp~="C08"] .md-typeset h4:has(+ .highlight) {
+  margin: 1.2em 0 0;
+  padding: .25em .8em;
+  font-size: .75rem;
