+html[data-slp~="C10"] [data-md-color-scheme="slate"] .md-typeset .slp-ss-tag { color: #8ab4f8; }
+html[data-slp~="C10"] [data-md-color-scheme="slate"] .md-typeset .slp-ss-env { color: #f6ad7b; }
+
+/* C11 注意書きの節をバルーン風にする（div.slp-notes を角の丸い吹き出しにし、左に尻尾を付ける。尻尾は箱の外の余白に置く） */
+html[data-slp~="C11"] .md-typeset .slp-notes {
