+}
+html[data-slp~="C12"] .md-typeset h1 { padding-right: 64px; }
+html[data-slp~="C12"] [data-md-color-scheme="slate"] .md-typeset .slp-character {
+  filter: drop-shadow(0 0 2px rgba(255, 255, 255, .55));
+}
+/* 狭い画面では小さくする（h1 の字が小さくなる幅。Material の 44.984375em と同じ） */
+@media screen and (max-width: 44.984375em) {
+  html[data-slp~="C12"] .md-typeset .slp-character { width: 36px; height: 54px; }
+  html[data-slp~="C12"] .md-typeset h1 { padding-right: 44px; }
+}
+
+/* C14 ファイルごとの説明の切れ目を見せる（manual/ghost だけに絞る。頁の種類の印の代わりに :has(h1#ゴースト)）。
+   ファイル名を 1 行に置いて説明を字下げし、ファイルの間に細い線を引く。
+   「**名前**: 説明」の「: 」は字の要素でないので見た目の指定では消せない。段落を flex で折り返して名前を 1 行目に置き、
+   「: 」を負の字下げで左の余白に出して名前の ::after で覆う（試作だけの細工。本番では目印を付けて「: 」を外す） */
+html[data-slp~="C14"] .md-typeset:has(h1#ゴースト) > ul { margin-left: 0; }
+html[data-slp~="C14"] .md-typeset:has(h1#ゴースト) > ul > li {
+  margin: 0;
+  padding: .5em 0 .3em;
+  list-style: none;
+  border-top: 1px solid var(--md-default-fg-color--lighter);
+}
+html[data-slp~="C14"] .md-typeset:has(h1#ゴースト) > ul > li > p { margin-left: 1.5em; }
+html[data-slp~="C14"] .md-typeset:has(h1#ゴースト) > ul > li > p:first-child {
+  display: flex;
+  flex-wrap: wrap;
+  margin-top: 0;
+  text-indent: -.5em;
+}
+html[data-slp~="C14"] .md-typeset:has(h1#ゴースト) > ul > li > p:first-child > strong:first-child {
+  position: relative;
+  flex: 0 0 calc(100% + 1.5em);
+  margin: 0 0 .2em -1.5em;
+  text-indent: 0;
+}
+html[data-slp~="C14"] .md-typeset:has(h1#ゴースト) > ul > li > p:first-child > strong:first-child::after {
+  content: "";
+  position: absolute;
+  top: 100%;
+  left: .9em;
+  width: .5em;
+  height: 1.7em;
+  margin-top: .2em;
+  background: var(--md-default-bg-color);
+}
+
+/* C15 ファイル構成の木でファイル名に色を付ける（assets/mockup.js が「+-」の行の名前を span で包む。拡張子のある名前をファイル、無い名前をフォルダとする） */
+html[data-slp~="C15"] .md-typeset .slp-tree-file { color: var(--md-primary-fg-color); }
+html[data-slp~="C15"] [data-md-color-scheme="slate"] .md-typeset .slp-tree-file { color: #81c784; }
+
+/* C17: 明るい表示の色付きの字を濃くする（白地で 7:1 以上。開発者の指摘 2026-10-25）。暗い表示は変えない */
+html[data-slp~="C17"] [data-md-color-scheme="default"] { --md-typeset-a-color: #185a1c; }
+html[data-slp~="C17"] [data-md-color-scheme="default"] .md-typeset .slp-bw-materia { color: #6b4500; }
+html[data-slp~="C17"] [data-md-color-scheme="default"] .md-typeset .slp-bw-ssp { color: #185a1c; }
+html[data-slp~="C17"] [data-md-color-scheme="default"] .md-typeset .slp-bw-crow { color: #5a1a85; }
+html[data-slp~="C17"] [data-md-color-scheme="default"] .md-typeset .slp-bw-ninix { color: #0d47a1; }
+html[data-slp~="C17"] [data-md-color-scheme="default"] .md-typeset .slp-ss-tag { color: #0842a0; }
+html[data-slp~="C17"] [data-md-color-scheme="default"] .md-typeset .slp-ss-env { color: #7a2e0a; }
+html[data-slp~="C17"] [data-md-color-scheme="default"] .md-typeset .slp-tree-file { color: #185a1c; }
+
+/* C18: 記述例を強く目立たせる（C08 の箱を、濃い緑の頭の帯と左の太い線にする。C08 なしでも効く。開発者の指摘 2026-10-25） */
+html[data-slp~="C18"] .md-typeset h4:has(+ .highlight) {
+  margin: 1.4em 0 0;
+  padding: .3em .8em;
+  font-size: .75rem;
+  color: #ffffff;
+  background: #1b5e20;
+  border-radius: .2rem .2rem 0 0;
+}
+html[data-slp~="C18"] .md-typeset :is(h4, .highlight) + .highlight {
+  margin-top: 0;
+  border-left: .35rem solid #1b5e20;
+  background: #eef5ee;
+}
+html[data-slp~="C18"] .md-typeset :is(h4, .highlight) + .highlight :is(pre, code) { background: transparent; }
+html[data-slp~="C18"] .md-typeset .highlight + .highlight { border-top: 1px dashed #1b5e20; }
+html[data-slp~="C18"] .md-typeset :is(h4, .highlight) + .highlight:has(+ .highlight) { margin-bottom: 0; }
+html[data-slp~="C18"] .md-typeset :is(h4, .highlight) + div.highlight > pre { margin: 0; }
+html[data-slp~="C18"] [data-md-color-scheme="slate"] .md-typeset h4:has(+ .highlight) { background: #2e7d32; }
+html[data-slp~="C18"] [data-md-color-scheme="slate"] .md-typeset :is(h4, .highlight) + .highlight { border-left-color: #66bb6a; background: #1f2a20; }
+
+/* C19: さくらスクリプトのタグと環境変数を太字にする（C10 の span に当てる。色だけでは別の画面で見分けにくいという開発者の指摘 2026-10-25） */
+html[data-slp~="C19"] .md-typeset :is(.slp-ss-tag, .slp-ss-env) { font-weight: 700; }
+
+/* C20: さくらスクリプトのタグの色を青から赤紫に替える（濃い青は黒の地の字と見分けにくいという開発者の指摘 2026-10-25） */
+html[data-slp~="C20"] [data-md-color-scheme="default"] .md-typeset .slp-ss-tag { color: #8a0d4f; }
+html[data-slp~="C20"] [data-md-color-scheme="slate"] .md-typeset .slp-ss-tag { color: #f48fb1; }
+
+/* C21: さくらスクリプトのタグと環境変数に、字の色を薄めた地を敷く（色相に頼らず、面で目立たせる） */
+html[data-slp~="C21"] .md-typeset :is(.slp-ss-tag, .slp-ss-env) { background: color-mix(in srgb, currentColor 9%, transparent); border-radius: .15em; }
+
+/* C22: manual/ghost のファイル名（C14 で 1 行に置いた名前）を、C01 の項目名と同じ帯にする（開発者の指摘 2026-10-25「descript.txt は OnBoot などと同じ装飾で」）。C14 が要る */
+html[data-slp~="C14"][data-slp~="C22"] .md-typeset:has(h1#ゴースト) > ul > li { border-top: 0; padding-top: .8em; }
+html[data-slp~="C14"][data-slp~="C22"] .md-typeset:has(h1#ゴースト) > ul > li > p:first-child > strong:first-child,
+html[data-slp~="C14"][data-slp~="C22"] .md-typeset:has(h1#ゴースト) > ul > li > strong:only-child {
+  display: block;
+  margin-bottom: .5em;
+  padding: .35em .6em;
+  font-size: 1.25em;
+  font-weight: 400;
+  border-left: .3rem solid var(--md-primary-fg-color);
+  border-bottom: 1px solid var(--md-default-fg-color--lighter);
+  background: var(--md-default-fg-color--lightest);
+}
+
+/* 帯の中のリンクは OnBoot などの項目名と同じ字の色にする（暗い表示でリンクの緑が帯の灰色に沈むため） */
+html[data-slp~="C14"][data-slp~="C22"] .md-typeset:has(h1#ゴースト) > ul > li > p:first-child > strong:first-child a,
+html[data-slp~="C14"][data-slp~="C22"] .md-typeset:has(h1#ゴースト) > ul > li > strong:only-child a { color: var(--md-default-fg-color); }
+/* C22 では「: 」を assets/mockup.js が外すので、C14 の覆いは要らない */
+html[data-slp~="C14"][data-slp~="C22"] .md-typeset:has(h1#ゴースト) > ul > li > p:first-child { text-indent: 0; }
+html[data-slp~="C14"][data-slp~="C22"] .md-typeset:has(h1#ゴースト) > ul > li > p:first-child > strong:first-child::after { content: none; }
+
+/* C23: キーの表（assets/mockup.js が作る）。キーの列は折り返さない */
+html[data-slp~="C23"] .md-typeset table.slp-keytable { display: table; width: 100%; font-size: .75rem; }
+html[data-slp~="C23"] .md-typeset table.slp-keytable td:last-child { overflow-wrap: anywhere; }
+html[data-slp~="C23"] .md-typeset table.slp-keytable td:first-child { white-space: nowrap; font-weight: 700; }
