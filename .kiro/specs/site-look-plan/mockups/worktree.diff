+html[data-slp~="C08"] .md-typeset :is(h4, .highlight) + .highlight:has(+ .highlight) { margin-bottom: 0; border-bottom: none; }
+html[data-slp~="C08"] .md-typeset :is(h4, .highlight) + div.highlight > pre { margin: 0; }
+
+/* C09 コピーのボタンの下に字を重ねない（コードの右の内側の余白をボタンの分だけ広げる。pre > code はどちらの形にも効く） */
+html[data-slp~="C09"] .md-typeset pre > code {
+  padding-right: 2.8em;
+}
+
+/* C10 さくらスクリプトに色を付ける（assets/mockup.js が code.language-sakurascript の字を包む。太さ・大きさは変えない） */
