+html[data-slp~="C11"] .md-typeset .slp-notes::before { left: -22px; border-right: 12px solid var(--md-primary-fg-color); }
+html[data-slp~="C11"] .md-typeset .slp-notes::after { left: -17px; border-right: 12px solid var(--md-default-bg-color); }
+html[data-slp~="C11"] .md-typeset .slp-notes > :is(h2, h3):first-child { margin-top: 0; padding-top: .4em; }
+
+/* C02 項目の間を詰める（まとめ頁の項目の間の hr と、項目名の h3 の上下の余白を小さくする。hr と h3 だけでは 700 px に 3.5 項目だったので、段落の上下の余白も詰める） */
+html[data-slp~="C02"] .md-typeset hr {
+  margin: .6em 0;
+}
