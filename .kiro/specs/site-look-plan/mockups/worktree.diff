+  background: var(--md-default-fg-color--lightest);
+}
+html[data-slp~="C01"] .md-typeset h3:not([id^="notes_"]) code {
+  background: transparent;
+  padding: 0;
+}
+
+/* C03 分類の見出しを濃い帯にする（注意書きの節の h2 は除く） */
