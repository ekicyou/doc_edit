+  color: var(--md-primary-bg-color);
+}
+
+/* C07 既定値を説明の文と分けて見せる（prepare_site.py の p.slp-default。字下げ・少し小さい控えめの字。斜めの字は使わない） */
+html[data-slp~="C07"] .md-typeset p.slp-default {
